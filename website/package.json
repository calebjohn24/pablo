{
  "name": "pablo-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "dev": "npm run sync:docs && vitepress dev . --host 0.0.0.0",
    "build": "npm run sync:docs && vitepress build .",
    "preview": "vitepress preview . --host 0.0.0.0",
    "test": "npm run build && node --test tests/site.test.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name runpablo --branch main"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "vitepress": "1.6.4",
    "wrangler": "4.92.0"
  }
}
