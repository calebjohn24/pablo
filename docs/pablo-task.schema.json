{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pablo single-task results c2.3 / c3.13 structured validation",
  "$ref": "#/$defs/task",
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [
            "c2.3",
            "c3.13"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "accounting": {
          "anyOf": [
            {
              "$ref": "#/$defs/accounting"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "invalid_arguments",
                    "invalid_configuration",
                    "credential_unavailable",
                    "trace_setup_failed"
                  ]
                }
              },
              "required": [
                "code"
              ],
              "additionalProperties": false
            }
          ]
        },
        "output_validation": {
          "$ref": "#/$defs/output_validation"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "session_id",
        "trace_id",
        "outcome",
        "accounting",
        "error"
      ],
      "oneOf": [
        {
          "properties": {
            "error": {
              "type": "null"
            },
            "outcome": {
              "type": "object"
            },
            "accounting": {
              "type": "object"
            },
            "run_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "run_id": {
              "type": "null"
            },
            "session_id": {
              "type": "null"
            },
            "trace_id": {
              "type": "null"
            },
            "outcome": {
              "type": "null"
            },
            "accounting": {
              "type": "null"
            },
            "error": {
              "type": "object"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "c3.13"
              }
            }
          },
          "then": {
            "required": [
              "output_validation"
            ],
            "properties": {
              "error": {
                "type": "null"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "output_validation"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "output_validation"
            ],
            "properties": {
              "output_validation": {
                "properties": {
                  "status": {
                    "const": "valid"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "completed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "output_validation"
            ],
            "properties": {
              "output_validation": {
                "properties": {
                  "status": {
                    "const": "invalid"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "failed"
                  },
                  "code": {
                    "const": "output_validation_failed"
                  }
                },
                "required": [
                  "status",
                  "code"
                ]
              }
            }
          }
        }
      ]
    },
    "accounting": {
      "type": "object",
      "properties": {
        "model_calls": {
          "$ref": "#/$defs/decimal"
        },
        "tool_calls": {
          "$ref": "#/$defs/decimal"
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "$ref": "#/$defs/nullable_decimal"
            },
            "output_tokens": {
              "$ref": "#/$defs/nullable_decimal"
            },
            "cache_read_input_tokens": {
              "$ref": "#/$defs/nullable_decimal"
            },
            "cache_write_input_tokens": {
              "$ref": "#/$defs/nullable_decimal"
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "cache_read_input_tokens",
            "cache_write_input_tokens"
          ],
          "additionalProperties": false
        },
        "cost_microusd": {
          "$ref": "#/$defs/nullable_decimal"
        },
        "charged_tokens": {
          "$ref": "#/$defs/nullable_decimal"
        },
        "charged_cost_microusd": {
          "$ref": "#/$defs/nullable_decimal"
        }
      },
      "additionalProperties": false,
      "required": [
        "model_calls",
        "tool_calls",
        "usage",
        "cost_microusd",
        "charged_tokens",
        "charged_cost_microusd"
      ]
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "nullable_decimal": {
      "anyOf": [
        {
          "$ref": "#/$defs/decimal"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_write_input_tokens"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "output": {
              "type": "string",
              "maxLength": 4194304
            },
            "finish_reason": {
              "const": "stop"
            },
            "usage": {
              "$ref": "#/$defs/usage"
            }
          },
          "required": [
            "status",
            "output",
            "finish_reason",
            "usage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "cancelled"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "timed_out"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "policy_denied"
            },
            "rule": {
              "oneOf": [
                {
                  "enum": [
                    "tool_unavailable",
                    "workspace",
                    "environment",
                    "unsupported_platform",
                    "symlink"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "configured": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "configured"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "status",
            "rule"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "limit_exceeded"
            },
            "limit": {
              "enum": [
                "input_bytes",
                "output_bytes",
                "output_tokens",
                "model_calls",
                "events",
                "trace_bytes",
                "tool_calls",
                "tool_input_bytes",
                "tool_output_bytes",
                "context_bytes",
                "filesystem_work",
                "total_tokens",
                "cost"
              ]
            }
          },
          "required": [
            "status",
            "limit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "failed"
            },
            "code": {
              "enum": [
                "provider_rejected",
                "provider_transport",
                "malformed_stream",
                "unsupported_provider_content",
                "event_sink_io",
                "invalid_tool_arguments",
                "tool_execution",
                "tool_cleanup",
                "accounting_bound_violated",
                "context_overflow",
                "compaction_failed",
                "output_validation_failed"
              ]
            },
            "delivery": {
              "enum": [
                "not_sent",
                "may_have_been_sent",
                "response_received"
              ]
            }
          },
          "required": [
            "status",
            "code",
            "delivery"
          ],
          "additionalProperties": false
        }
      ]
    },
    "output_validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "output-validation-v1"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "unvalidated",
            "valid",
            "invalid"
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "malformed_json",
                  "json_bytes",
                  "validation_work",
                  "json_structure",
                  "schema_violation"
                ]
              },
              "instance_path": {
                "type": "string",
                "maxLength": 256
              },
              "schema_path": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "code",
              "instance_path",
              "schema_path"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "schema_sha256",
        "status",
        "diagnostics"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "invalid"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
