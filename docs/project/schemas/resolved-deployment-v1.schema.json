{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pablo:resolved-deployment:1:c3.26",
  "title": "Pablo resolved deployment v1 \u2014 C3.22 contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "contract_revision": {
      "const": "c3.26"
    },
    "config": {
      "$ref": "urn:pablo:deployment:1:c3.26#/$defs/resolvedConfig"
    },
    "fingerprint": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "kind": {
            "enum": [
              "defaults",
              "file",
              "profile",
              "environment",
              "override",
              "host_authority"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "digest": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "locator",
          "digest"
        ]
      },
      "maxItems": 65536
    },
    "provenance": {
      "type": "object",
      "maxProperties": 65536,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^/config(?:/.*)?$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "operation": {
              "enum": [
                "default",
                "set",
                "replace",
                "append",
                "prepend",
                "unset",
                "constrain"
              ]
            }
          },
          "required": [
            "source",
            "operation"
          ]
        },
        "maxItems": 65536,
        "minItems": 1
      }
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "profile": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "provider": {
                    "enum": [
                      "vercel",
                      "openrouter",
                      "open_responses"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "endpoint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "protocol": {
                    "enum": [
                      "chat_completions",
                      "open-responses-http-sse"
                    ]
                  },
                  "adapter_available": {
                    "type": "boolean"
                  },
                  "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "text_streaming": {
                        "type": "boolean"
                      },
                      "tool_calls": {
                        "type": "boolean"
                      },
                      "reported_usage": {
                        "type": "boolean"
                      },
                      "reported_cost": {
                        "type": "boolean"
                      },
                      "hard_accounting_bounds": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "text_streaming",
                      "tool_calls",
                      "reported_usage",
                      "reported_cost",
                      "hard_accounting_bounds"
                    ]
                  },
                  "open_responses": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "endpoint": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "capability_profile": {
                        "const": "open-responses-text-tools-v1"
                      },
                      "auth_header": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "auth_scheme": {
                        "enum": [
                          "bearer",
                          "raw"
                        ]
                      },
                      "revision": {
                        "const": "92c12d96d7b61d6d15e2214daa5e9c6000ab6e1c"
                      }
                    },
                    "required": [
                      "endpoint",
                      "model",
                      "capability_profile",
                      "auth_header",
                      "auth_scheme",
                      "revision"
                    ]
                  },
                  "context_window_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  },
                  "reasoning": {
                    "$ref": "urn:pablo:deployment:1:c3.26#/$defs/reasoning"
                  },
                  "reasoning_capabilities": {
                    "$ref": "urn:pablo:deployment:1:c3.26#/$defs/reasoningCapabilities"
                  }
                },
                "required": [
                  "provider",
                  "model",
                  "endpoint",
                  "protocol",
                  "adapter_available",
                  "capabilities"
                ]
              },
              "credential": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "max_output_tokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "upstream_routing": {
                "const": "opaque_to_pablo"
              }
            },
            "required": [
              "name",
              "profile",
              "credential",
              "max_output_tokens",
              "upstream_routing"
            ]
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "per_attempt_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            "eligible_errors": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "not_sent",
                  "rate_limited",
                  "service_unavailable",
                  "transport_uncertain"
                ]
              }
            },
            "retry_uncertain_delivery": {
              "type": "boolean"
            },
            "retry_owner": {
              "const": "pablo"
            },
            "sticky": {
              "const": true
            },
            "required_capabilities": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "text_streaming",
                  "tool_calls",
                  "structured_output"
                ]
              }
            }
          },
          "required": [
            "max_attempts",
            "per_attempt_timeout_ms",
            "eligible_errors",
            "retry_uncertain_delivery",
            "retry_owner",
            "sticky",
            "required_capabilities"
          ]
        },
        "selected_entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "selection_reason": {
          "enum": [
            "first_declared_compatible_entry",
            "inherited_ordered_subsequence"
          ]
        },
        "execution_available": {
          "type": "boolean"
        },
        "fallback_owner": {
          "const": "C3.11"
        }
      },
      "required": [
        "name",
        "entries",
        "policy",
        "selected_entry",
        "selection_reason",
        "execution_available",
        "fallback_owner"
      ]
    }
  },
  "required": [
    "schema_version",
    "contract_revision",
    "config",
    "fingerprint",
    "sources",
    "provenance",
    "input_fingerprint"
  ]
}
