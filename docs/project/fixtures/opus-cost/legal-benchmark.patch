+"""Strict accounting and bounded, content-free Vercel generation lookups."""
+from decimal import Decimal, InvalidOperation
+import json
+import math
+import re
+import time
+from urllib.request import Request, urlopen
+from urllib.error import HTTPError, URLError
+
+GENERATION_ID = re.compile(r"gen_[0-7][0-9A-HJKMNP-TV-Z]{25}\Z")
+
+
+def counter(value):
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int) and 0 <= value <= 2**64 - 1:
+        return value
+    if isinstance(value, str) and re.fullmatch(r"0|[1-9][0-9]{0,19}", value):
+        number = int(value)
+        return number if number <= 2**64 - 1 else None
+    return None
+
+
+def amount(value):
+    if isinstance(value, bool) or value is None:
+        return None
+    try:
+        number = Decimal(str(value))
+        return number if number.is_finite() and number >= 0 and math.isfinite(float(number)) else None
+    except InvalidOperation:
+        return None
+
+
+def estimate(usage, model):
+    counts = [counter(usage.get(k)) for k in (
+        "input_tokens", "output_tokens", "cache_read_input_tokens", "cache_write_input_tokens")]
+    if any(v is None for v in counts):
+        return None
+    inp, out, read, write = counts
+    if read + write > inp:
+        return None
+    rates = {"zai/glm-5.3-flash": (".15", ".5", ".03", "0"),
+             "anthropic/claude-opus-5": ("5", "25", ".5", "6.25")}.get(model)
+    if rates is None:
+        return None
+    return float(sum(Decimal(n)*Decimal(r) for n, r in
+                     zip((inp-read-write, out, read, write), rates)) / 1_000_000)
+
+
+def generation_ids(trace):
+    ids = []
+    calls = 0
+    for line in trace.splitlines():
+        event = json.loads(line)
+        # Native call diagnostics appear only on model_call_completed records.
+        if (event.get("kind") or event).get("type") == "model.finished":
+            event = event.get("kind") or event
+            calls += 1
+            value = (event.get("diagnostics") or {}).get("generation_id")
+            if isinstance(value, str) and GENERATION_ID.fullmatch(value):
+                ids.append(value)
+    return ids, calls
+
+
+def lookup(generation_id, key, *, fetch=None, sleep=time.sleep):
+    if not GENERATION_ID.fullmatch(generation_id):
+        raise ValueError("invalid generation ID")
+    def request():
+        req = Request("https://ai-gateway.vercel.sh/v1/generation?id=" + generation_id,
+                      headers={"Authorization": "Bearer " + key})
+        with urlopen(req, timeout=20) as response:
+            raw = response.read(65537)
+            if len(raw) > 65536:
+                raise ValueError("oversized generation record")
+            return json.loads(raw)
+    fetch = fetch or request
+    for attempt in range(5):
+        try:
+            record = fetch()
+            data = record.get("data") or {}
+            if data.get("id") == generation_id:
+                provider = data.get("provider_name")
+                return {"id": generation_id, "gateway_cost_usd":
+                        float(amount(data.get("total_cost"))) if amount(data.get("total_cost")) is not None else None,
+                        "provider": provider if isinstance(provider, str) and len(provider) <= 128
+                        and re.fullmatch(r"[a-zA-Z0-9_. -]+", provider) else None,
+                        "model": data.get("model") if isinstance(data.get("model"), str) and len(data["model"]) <= 256 else None,
+                        "cache_read_input_tokens": counter(data.get("native_tokens_cached")),
+                        "cache_write_input_tokens": counter(data.get("native_tokens_cache_creation"))}
+        except HTTPError as exc:
+            if exc.code not in (404, 429, 500, 502, 503, 504):
+                return None
+        except (URLError, TimeoutError, ValueError):
+            pass
+        if attempt < 4:
+            sleep(2 ** attempt)
+    return None
+
+
+def enrich(events, trace, key):
+    ids, calls = generation_ids(trace)
+    records = [lookup(value, key) for value in ids]
+    complete = calls > 0 and len(ids) == calls and len(set(ids)) == calls and all(
+        r is not None and r["gateway_cost_usd"] is not None for r in records)
+    events["generation_records"] = records
+    events["generation_count"] = calls
+    events["billing_complete"] = complete
+    events["reported_cost_usd"] = sum(r["gateway_cost_usd"] for r in records) if complete else None
+    events["reported_cost_source"] = "vercel_generation_lookup" if complete else None
+    return events
