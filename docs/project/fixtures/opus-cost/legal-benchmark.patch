+import json
+import unittest
+import tempfile
+from pathlib import Path
+from unittest.mock import patch
+from legalbench.billing import counter, estimate, lookup, enrich, generation_ids
+from legalbench.adapters import adapters
+
+ID = 'gen_01ARZ3NDEKTSV4RRFFQ69G5FAV'
+
+class BillingTests(unittest.TestCase):
+    def test_gateway_enrichment_preserves_other_provider_costs(self):
+        from legalbench.runner import _enrich_gateway_billing
+        results = [
+            {'attempt':'router', 'provider':'openrouter', 'events':{
+                'reported_cost_usd':.3, 'reported_cost_source':'provider_reported'}},
+            {'attempt':'gateway', 'provider':'vercel', 'events':{'reported_cost_usd':None}},
+        ]
+        trace = json.dumps({'type':'model.finished','diagnostics':{'generation_id':ID}})
+        def enrich(events, content, key):
+            self.assertEqual(content, trace)
+            self.assertEqual(key, 'private-test-key')
+            events.update(reported_cost_usd=.2, reported_cost_source='vercel_generation_lookup')
+        with tempfile.TemporaryDirectory() as temp:
+            root=Path(temp)
+            for result in results:
+                raw=root/result['attempt']/'raw'
+                raw.mkdir(parents=True)
+                (raw/'pablo-trace.jsonl').write_text(trace)
+            with patch('legalbench.billing.enrich', side_effect=enrich) as mocked:
+                _enrich_gateway_billing(results, root, 'private-test-key')
+            mocked.assert_called_once()
+            self.assertEqual(results[0]['events'], {
+                'reported_cost_usd':.3, 'reported_cost_source':'provider_reported'})
+            self.assertFalse((root/'router/result.json').exists())
+            saved=json.loads((root/'gateway/result.json').read_text())
+            self.assertEqual(saved['events']['reported_cost_usd'], .2)
+            self.assertEqual(saved['events']['reported_cost_source'], 'vercel_generation_lookup')
+
+    def test_counters_missing_zero_decimal_and_invalid(self):
+        for value in [None, True, -1, 1.2, '1.0', '+1', ' 1', '01', str(2**64)]:
+            self.assertIsNone(counter(value))
+        self.assertEqual(counter('0'), 0)
+        self.assertEqual(counter(str(2**64-1)), 2**64-1)
+        u = dict(input_tokens='100', output_tokens='2', cache_read_input_tokens='0', cache_write_input_tokens='0')
+        self.assertIsNotNone(estimate(u, 'anthropic/claude-opus-5'))
+        u['cache_write_input_tokens'] = None
+        self.assertIsNone(estimate(u, 'anthropic/claude-opus-5'))
+        u.update(cache_write_input_tokens='60', cache_read_input_tokens='50')
+        self.assertIsNone(estimate(u, 'anthropic/claude-opus-5'))
+
+    def test_decimal_cost_is_reported_and_estimates_are_separate(self):
+        a = adapters('opus', 'glm')['pablo-opus5-vercel']
+        n = a.normalize(json.dumps({'accounting': {'cost_microusd':'123456'}}), [])
+        self.assertEqual(n['reported_cost_usd'], .123456)
+        self.assertEqual(n['reported_cost_source'], 'provider_reported')
+        self.assertIsNone(n['estimated_cost_usd'])
+
+    def test_delayed_lookup_and_unknown_fields(self):
+        calls = iter([{'error':'Usage event not found'}, {'data': {'id':ID, 'total_cost':'.02', 'provider_name':'anthropic', 'native_tokens_cached':0}}])
+        sleeps = []
+        r = lookup(ID, 'private', fetch=lambda: next(calls), sleep=sleeps.append)
+        self.assertEqual(sleeps, [1])
+        self.assertEqual(r['gateway_cost_usd'], .02)
+        self.assertEqual(r['cache_read_input_tokens'], 0)
+        self.assertIsNone(r['cache_write_input_tokens'])
+        self.assertIsNone(lookup(ID, 'private', fetch=lambda:{}, sleep=lambda _:None))
+        with self.assertRaises(ValueError):
+            lookup('gen_../../private', 'private')
+
+    def test_generation_validation_and_incomplete_coverage(self):
+        trace = '\n'.join(json.dumps({'type':'model.finished','diagnostics':{'generation_id':v}}) for v in [ID, 'private'])
+        self.assertEqual(generation_ids(trace), ([ID], 2))
+        with patch('legalbench.billing.lookup', return_value={'id':ID, 'gateway_cost_usd':.1}):
+            e = enrich({}, trace, 'private')
+        self.assertFalse(e['billing_complete'])
+        self.assertIsNone(e['reported_cost_usd'])
+
+if __name__ == '__main__':
+    unittest.main()
