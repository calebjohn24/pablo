+#!/usr/bin/env python3
+"""Frozen 10-attempt pilot; expand only with cache hits and full billing coverage."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+PILOT = 'notice-cure-01,corporate-approval-01,incident-notification-01,privilege-review-01'
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def pilot_gate(reports):
+    rows = [a for r in reports for a in r['attempts']]
+    return len(rows) == 8 and all(a['events'].get('billing_complete') and all(
+        r and r.get('provider') and r.get('cache_read_input_tokens') is not None
+        and r.get('cache_write_input_tokens') is not None for r in a['events'].get('generation_records', []))
+        for a in rows) and any(r.get('cache_read_input_tokens', 0) > 0
+        for a in rows[4:] for r in a['events'].get('generation_records', []) if r)
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('--archive', type=Path, required=True)
+    p.add_argument('--archive-sha256', required=True)
+    p.add_argument('--binary-sha256', required=True)
+    p.add_argument('--source-revision', required=True)
+    p.add_argument('--output', type=Path, required=True)
+    args = p.parse_args()
+    if args.output.exists():
+        raise SystemExit('output already exists; interrupted attempts must be retained')
+    args.output.mkdir(parents=True)
+    def run(label, systems, tasks, caching, seed):
+        out = args.output / label
+        result = subprocess.run([sys.executable, str(ROOT/'scripts/run_e2b.py'),
+            '--systems',systems,'--tasks',tasks,'--output',str(out),'--serial',
+            '--pablo-archive',str(args.archive),'--archive-sha256',args.archive_sha256,
+            '--binary-sha256',args.binary_sha256,'--prompt-caching',caching,'--seed',str(seed)])
+        if result.returncode:
+            raise SystemExit('experiment stopped; preserve partial results in '+str(out))
+        return json.loads((out/'report.json').read_text())
+    def fingerprint(paths):
+        digest = hashlib.sha256()
+        for path in sorted(paths):
+            digest.update(str(path.relative_to(ROOT)).encode()+b"\0"+path.read_bytes())
+        return digest.hexdigest()
+    identity = {'suite_sha256':fingerprint(p for p in (ROOT/'tasks').rglob('*') if p.is_file()),
+                'harness_sha256':fingerprint(list((ROOT/'legalbench').glob('*.py'))+list((ROOT/'scripts').glob('*.py'))),
+                'source_revision':args.source_revision,'archive_sha256':args.archive_sha256,
+                'binary_sha256':args.binary_sha256,'task_manifest_sha256':hashlib.sha256((ROOT/'tasks/manifest.json').read_bytes()).hexdigest()}
+    (args.output/'identity.json').write_text(json.dumps(identity,indent=2)+'\n')
+    off = run('pilot-off','pablo-opus5-vercel',PILOT,'provider_default',41)
+    on = run('pilot-on','pablo-opus5-vercel',PILOT,'auto',41)
+    run('pilot-competitors','claude-opus,claude-sdk-opus','notice-cure-01','provider_default',41)
+    passed = pilot_gate([off,on])
+    (args.output/'pilot-gate.json').write_text(json.dumps({'passed':passed,
+        'requires':'8 attempted tasks; every generation has gateway cost, provider, cache reads/writes; auto has cache reads'},indent=2)+'\n')
+    if not passed:
+        raise SystemExit('pilot observability/cache-read gate failed; no main attempts authorized by gate')
+    for seed in (41,42,43):
+        order = ['provider_default','auto'] if seed != 42 else ['auto','provider_default']
+        for caching in order:
+            run(f'main-{seed}-{caching}','pablo-opus5-vercel','all',caching,seed)
+    run('main-competitors','claude-opus,claude-sdk-opus','all','provider_default',42)
+
+if __name__ == '__main__':
+    main()
