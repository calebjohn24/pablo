+#!/usr/bin/env python3
+"""Sanitized aggregate gates; never copy task content, keys or raw provider records."""
+import argparse
+from collections import Counter, defaultdict
+import hashlib
+import json
+from pathlib import Path
+import random
+import statistics
+
+
+def summarize(rows):
+    costs = [a['events'].get('reported_cost_usd') for a in rows]
+    complete = bool(rows) and all(v is not None for v in costs)
+    routes = Counter(r['provider'] for a in rows for r in a['events'].get('generation_records',[]) if r and r.get('provider'))
+    families = defaultdict(int)
+    for a in rows:
+        families[a['family']] += sum(bool(c['factual']) for c in a['score']['checks'])
+    latencies = [a['resources']['wall_ms'] for a in rows]
+    return {'attempts':len(rows),'failures':sum(a['status']!='completed' for a in rows),
+            'cost_coverage':sum(v is not None for v in costs)/len(rows) if rows else 0,
+            'mean_cost_per_attempt':statistics.fmean(costs) if complete else None,
+            'mean_factual':statistics.fmean(a['score']['factual_accuracy'] for a in rows) if rows else None,
+            'mean_citation':statistics.fmean(a['score']['citation_score'] for a in rows) if rows else None,
+            'mean_wall_ms':statistics.fmean(latencies) if rows else None,
+            'provider_routes':dict(routes),'correct_findings_per_family':dict(families)}
+
+
+def report(root):
+    groups = defaultdict(list)
+    hashes = {}
+    for path in sorted(root.glob('*/report.json')):
+        data = json.loads(path.read_text())
+        hashes[str(path.relative_to(root))] = hashlib.sha256(path.read_bytes()).hexdigest()
+        label = path.parent.name
+        if label.startswith('pilot'):continue
+        for a in data['attempts']:
+            setting = 'on' if label.endswith('-auto') else 'off'
+            key = setting if a['system']=='pablo-opus5-vercel' else a['system']
+            groups[key].append(a)
+    summaries = {k:summarize(v) for k,v in groups.items()}
+    off,on = summaries.get('off'),summaries.get('on')
+    gates = {'complete_400_attempts':sum(s['attempts'] for s in summaries.values())==400}
+    interval = None
+    if off and on:
+        full_cost = off['cost_coverage']==on['cost_coverage']==1
+        savings = 1-on['mean_cost_per_attempt']/off['mean_cost_per_attempt'] if full_cost and off['mean_cost_per_attempt'] else None
+        lost = {f:off['correct_findings_per_family'][f]-on['correct_findings_per_family'].get(f,0) for f in off['correct_findings_per_family']}
+        gates.update({'cost_coverage':full_cost,'saving_at_least_20_percent':savings is not None and savings>=.2,
+                      'no_additional_execution_failures':on['failures']<=off['failures'],
+                      'factual_decline_at_most_one_pp':on['mean_factual']>=off['mean_factual']-.01,
+                      'citation_decline_at_most_one_pp':on['mean_citation']>=off['mean_citation']-.01,
+                      'lost_findings_per_family_at_most_one':all(v<=1 for v in lost.values())})
+        summaries['comparison']={'relative_mean_savings':savings,'lost_findings_per_family':lost}
+        if full_cost:
+            # Cluster by task to retain correlation across the three repetitions.
+            clusters = defaultdict(lambda: {'off':[],'on':[]})
+            for setting in ['off','on']:
+                for a in groups[setting]:clusters[a['task_id']][setting].append(a['events']['reported_cost_usd'])
+            ids=sorted(clusters); rng=random.Random(41);samples=[]
+            for _ in range(2000):
+                selected=rng.choices(ids,k=len(ids))
+                x=statistics.fmean(c for i in selected for c in clusters[i]['off'])
+                y=statistics.fmean(c for i in selected for c in clusters[i]['on'])
+                if x:samples.append(1-y/x)
+            samples.sort();interval=[samples[int(len(samples)*.025)],samples[int(len(samples)*.975)]]
+    return {'summaries':summaries,'gates':gates,'all_passed':bool(off and on) and all(gates.values()),
+            'relative_savings_task_cluster_bootstrap_95_percent':interval,'report_sha256':hashes,
+            'uncertainty':'Three repetitions; serial blocks and opaque provider routing can confound causal savings. Unchanged scorer has known enum/key defects; exact-task costs are diagnostic.'}
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser();p.add_argument('root',type=Path);p.add_argument('output',type=Path);a=p.parse_args()
+    a.output.write_text(json.dumps(report(a.root),indent=2)+'\n')
