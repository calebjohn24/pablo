      },
      "expected": {
        "otel.resource_attributes": {
          "stage": "entry",
          "region": "fixture"
        },
        "trace.path": {
          "unset": true
        },
        "policy.read_roots.allow": [],
        "rule": "Missing leaves inherit; maps merge; unset clears optional leaves; empty arrays replace."
      }
    },
    {
