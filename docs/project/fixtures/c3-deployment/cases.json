    {
      "id": "G03-02",
      "owner": "C3.3",
      "status": "not_run",
      "input": {
        "authority_layers": [
          {
            "policy.tools.allow": [
              "fs.read",
              "fs.list"
            ]
          },
          {
            "policy.tools.allow": [
              "fs.read",
              "fs.search"
            ]
          }
        ],
        "ordinary_tools": [
          "fs.read",
          "fs.list",
          "fs.search"
        ],
        "action": "Exercise each request under both deciding layers."
