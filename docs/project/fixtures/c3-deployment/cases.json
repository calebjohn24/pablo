      "expected": {
        "allowed": [
          "fs.read"
        ],
        "denied": [
          "fs.list",
          "fs.search"
        ],
        "rule": "Intersection of independently evaluated allowlists, never union; all deciding IDs retained. Deny wins in any layer."
      }
