  "resolution_cases": [
    {
      "id": "G02-01",
      "owner": "C3.2",
      "status": "not_run",
      "input": {
        "entry": "production.toml",
        "bindings": {
          "workspace": "<explicit canonical temporary root>"
        }
      },
      "expected": {
        "resolved": "production.resolved.json",
        "compare": "Complete config and fingerprint equal golden; deterministic origins and source digests match. No secret lookup or agent work."
      }
    },
    {
      "id": "G02-02",
      "owner": "C3.2",
      "status": "not_run",
      "input": {
        "entry": "development.toml",
        "bindings": {
          "workspace": "<explicit canonical temporary root>"
        },
        "environment": {}
      },
      "expected": {
        "options.limits.max_tool_calls": 20,
        "options.limits.max_model_calls": "unlimited",
        "options.filesystem.write": true,
        "options.policy.read_roots.allow.ids": [
          "read.workspace",
          "read.shared",
          "read.docs"
        ],
        "options.trace.path": {
          "base": "workspace",
          "path": "trace-{session_id}.jsonl"
        }
      }
    },
    {
      "id": "G02-03",
      "owner": "C3.2",
      "status": "not_run",
      "input": {
        "entry": "development.toml",
        "environment": {
          "PABLO_CONFIG_TOOL_CALLS": "7"
        },
        "overrides": {
          "limits.max_tool_calls": 5
        }
      },
      "expected": {
        "options.limits.max_tool_calls": 5,
        "origins": [
          "default",
          "development.toml",
          "environment:PABLO_CONFIG_TOOL_CALLS",
          "override:limits.max_tool_calls"
        ],
        "rule": "File/profile then environment then explicit override; every contribution retained."
      }
    },
    {
      "id": "G02-04",
      "owner": "C3.2",
      "status": "not_run",
      "input": {
        "base": {
          "otel.resource_attributes": {
            "stage": "base",
            "region": "fixture"
          }
        },
        "entry": {
          "otel.resource_attributes": {
            "stage": "entry"
          },
          "trace.path": {
            "unset": true
          },
