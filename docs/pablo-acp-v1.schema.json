{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pablo ACP v1 checkpoint C1.3 metadata",
  "oneOf": [
    {
      "type": "boolean",
      "const": true
    },
    {
      "$ref": "#/$defs/correlation"
    },
    {
      "$ref": "#/$defs/terminal"
    }
  ],
  "$defs": {
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_write_input_tokens"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "output": {
              "type": "string",
              "maxLength": 65536
            },
            "finish_reason": {
              "const": "stop"
            },
            "usage": {
              "$ref": "#/$defs/usage"
            }
          },
          "required": [
            "status",
            "output",
            "finish_reason",
            "usage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "cancelled"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "timed_out"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "policy_denied"
            },
            "rule": {
              "enum": [
                "tool_unavailable",
                "workspace",
                "environment",
                "unsupported_platform"
              ]
            }
          },
          "required": [
            "status",
            "rule"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "limit_exceeded"
            },
            "limit": {
              "enum": [
                "input_bytes",
                "output_bytes",
                "output_tokens",
                "model_calls",
                "events",
                "trace_bytes",
                "tool_calls",
                "tool_input_bytes",
                "tool_output_bytes",
                "context_bytes"
              ]
            }
          },
          "required": [
            "status",
            "limit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "failed"
            },
            "code": {
              "enum": [
                "provider_rejected",
                "provider_transport",
                "malformed_stream",
                "event_sink_io",
                "invalid_tool_arguments",
                "tool_execution",
                "tool_cleanup"
              ]
            },
            "delivery": {
              "enum": [
                "not_sent",
                "may_have_been_sent",
                "response_received"
              ]
            }
          },
          "required": [
            "status",
            "code",
            "delivery"
          ],
          "additionalProperties": false
        }
      ]
    },
    "correlation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "c1.2"
        },
        "run_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "seq_start": {
          "type": "integer",
          "minimum": 1
        },
        "seq_end": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp_unix_micros": {
          "type": "integer",
          "minimum": 1
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          ]
        },
        "trace_flags": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}$"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "session_id",
        "seq_start",
        "seq_end",
        "timestamp_unix_micros",
        "trace_id",
        "span_id",
        "parent_span_id",
        "trace_flags"
      ],
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "c1.2"
        },
        "run_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "seq_start": {
          "type": "integer",
          "minimum": 1
        },
        "seq_end": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp_unix_micros": {
          "type": "integer",
          "minimum": 1
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          ]
        },
        "trace_flags": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}$"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "session_id",
        "seq_start",
        "seq_end",
        "timestamp_unix_micros",
        "trace_id",
        "span_id",
        "parent_span_id",
        "trace_flags",
        "outcome"
      ],
      "additionalProperties": false
    }
  }
}
